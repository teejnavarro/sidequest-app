# Copy to .env.local (or run: npx vercel env pull .env.local). Never commit real values.
DATABASE_URL=
# Random secret (32+ characters) that Better Auth uses to sign sign-in cookies. Different per environment.
BETTER_AUTH_SECRET=
# The address the app runs at, no trailing slash (http://localhost:3000 on your PC).
BETTER_AUTH_URL=
# From the Google Cloud OAuth client ("Sign in with Google").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
